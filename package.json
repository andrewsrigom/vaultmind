{
  "name": "vaultmind",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted multi-source RAG with cited answers over your own knowledge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewsrigom/vaultmind.git"
  },
  "homepage": "https://github.com/andrewsrigom/vaultmind#readme",
  "bugs": {
    "url": "https://github.com/andrewsrigom/vaultmind/issues"
  },
  "keywords": [
    "ai",
    "knowledge-management",
    "nextjs",
    "pgvector",
    "rag"
  ],
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "access:hash-password": "tsx scripts/hash-access-password.ts",
    "build": "next build",
    "build:db": "tsx scripts/run-with-local-database.ts build:rehearsal",
    "build:rehearsal": "tsx scripts/build-rehearsal.ts",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "dev": "next dev",
    "doctor": "tsx scripts/doctor.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "lint": "pnpm typegen && eslint .",
    "lint:fix": "pnpm typegen && eslint . --fix",
    "mcp:stdio": "tsx scripts/vaultmind-mcp.ts",
    "mcp:tools": "tsx scripts/print-mcp-tools.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "quality": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build:rehearsal",
    "quality:db": "pnpm lint && pnpm typecheck && pnpm test:db && pnpm build:db",
    "smoke:core": "pnpm smoke:github-baseline && pnpm smoke:notion-connected && pnpm smoke:local",
    "smoke:github-baseline": "tsx scripts/smoke-github-baseline.ts",
    "smoke:local": "pnpm smoke:rag-demo && pnpm smoke:workspace-doc-ask-ai && pnpm smoke:mcp-local && pnpm smoke:mcp-stdio",
    "smoke:rag-demo": "tsx scripts/smoke-rag-demo.ts",
    "smoke:mcp-local": "tsx scripts/smoke-mcp-local.ts",
    "smoke:mcp-stdio": "tsx scripts/smoke-mcp-stdio.ts",
    "smoke:notion-connected": "tsx scripts/smoke-notion-connected.ts",
    "smoke:workspace-doc-ask-ai": "tsx scripts/smoke-workspace-doc-ask-ai.ts",
    "start": "next start",
    "test": "vitest",
    "test:db": "tsx scripts/run-with-local-database.ts test:run",
    "test:run": "vitest run",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@mantine/core": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.562.0",
    "next": "^16.3.0",
    "openai": "^6.15.0",
    "pg": "8.20.0",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.70.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
