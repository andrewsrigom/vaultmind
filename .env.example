# Core runtime
DATABASE_URL="postgresql://vaultmind:vaultmind@localhost:5433/vaultmind"
VAULTMIND_BASE_URL="http://localhost:3000"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4.1-mini"

# Optional access lock. Generate the hash with:
# VAULTMIND_ACCESS_PASSWORD='use-a-long-password' pnpm access:hash-password
# Store only the generated hash. Never commit the plain password.
VAULTMIND_ACCESS_PASSWORD_HASH=""

# Encrypts OAuth tokens before PostgreSQL storage. Use a separate random value
# with at least 32 characters.
SOURCE_CREDENTIAL_ENCRYPTION_KEY=""

# GitHub can use a personal access token or the OAuth flow below.
GITHUB_TOKEN=""
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/integrations/github/callback"

# Optional Notion OAuth connector.
NOTION_OAUTH_CLIENT_ID=""
NOTION_OAUTH_CLIENT_SECRET=""
NOTION_REDIRECT_URI="http://localhost:3000/api/integrations/notion/callback"

# Optional Google Drive OAuth connector.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=""
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/api/integrations/google-drive/callback"

# Local MCP server. Select one indexed workspace.
VAULTMIND_MCP_WORKSPACE_INDEX_ID=""

# Optional local test and smoke overrides. Keep real credentials out of committed files.
PLAYWRIGHT_BASE_URL=""
PLAYWRIGHT_PORT="3000"
PLAYWRIGHT_REUSE_EXISTING_SERVER="false"
SMOKE_GITHUB_REPO_URL=""
SMOKE_NOTION_ALLOW_REINDEX="0"
SMOKE_NOTION_QUESTION=""
SMOKE_NOTION_SOURCE_ID=""
SMOKE_SOURCE_CREDENTIAL_ENCRYPTION_KEY=""
