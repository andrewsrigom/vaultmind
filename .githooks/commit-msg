#!/usr/bin/env sh
set -eu

commit_message_file="$1"
first_line="$(sed -n '1p' "$commit_message_file")"

case "$first_line" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

if printf '%s\n' "$first_line" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9-]+\))?!?: .{1,100}$'; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid commit message.

Use Conventional Commits:
  type(scope): summary

Allowed types:
  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test

Examples:
  feat: add GitHub source sync
  fix(rag): handle empty retrieval results
  ci: add database-backed tests
EOF

exit 1
